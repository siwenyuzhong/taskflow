{
  "name": "taskflow",
  "productName": "Sloth",
  "version": "2026.10.22-1",
  "description": "Sloth — 优雅的任务管理清单，支持定时到期提醒、一键续时长与任务分类",
  "author": {
    "name": "Chen Weiyong",
    "email": "hello@pengcheng.info"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --mac dmg",
    "smoke:lightmode": "electron smoke-lightmode.cjs",
    "smoke:topbar": "electron smoke-topbar-quick.cjs",
    "smoke:packed": "electron smoke-packed.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "lunar-typescript": "^1.8.6",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1",
    "wavesurfer.js": "^7.12.12",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  }
}
